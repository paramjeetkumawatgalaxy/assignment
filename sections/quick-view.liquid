<div id="quick-view-popup" class="quick-view-popup">
  <div class="quick-view-overlay"></div>
  <div class="quick-view-content">
    <button type="button" class="quick-view-close" aria-label="Close quick view" data-qv-close>
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    <div id="quick-view-body"></div>
  </div>
</div> 
<style>
  #quick-view-popup { font-size: {{ settings.font_size_desktop }}px; line-height: {{ settings.line_height_desktop }}px; }
  @media (max-width: 767px) {
    #quick-view-popup { font-size: {{ settings.font_size_mobile }}px; line-height:{{ settings.line_height_mobile }}px; }
  }
</style>
<script>
  window.quickViewBlocks = [
    {% for block in section.blocks %}
      "{{ block.type }}"{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ];
</script>

{% schema %}
{
  "name": "Quick View Settings",
  "blocks": [
    { "type": "title", "name": "Title" },
    { "type": "image", "name": "Image" },
    { "type": "price", "name": "Price" },
    { "type": "description", "name": "Description" },
    { "type": "variants", "name": "Variant Selector" },
    { "type": "add_to_cart", "name": "Add to Cart Button" }
  ],
  "presets": [
    {
      "name": "Quick View Configuration",
      "category": "Product",
      "blocks": [
        { "type": "image" },
        { "type": "title" },
        { "type": "price" },
        { "type": "description" },
        { "type": "variants" },
        { "type": "add_to_cart" }
      ]
    }
  ]
}
{% endschema %}
