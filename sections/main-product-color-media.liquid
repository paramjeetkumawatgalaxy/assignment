{% comment %}
--------------------------------------------------------------------
Product Section:
- Color-based image filter
- Dynamic price update
- AJAX Add to Cart
Compatible with Horizon theme and Shopify 2.0
--------------------------------------------------------------------
{% endcomment %}

<section id="Product-{{ section.id }}" class="custom-page-width custom-product-section"
  data-section-id="{{ section.id }}">
  <div class="custom-product-grid">

    <!-- PRODUCT MEDIA -->
    <div class="custom-product-information__media">
      {% for media in product.media %}
      <div class="product-media-item">
        <img src="{{ media | image_url: width: 1000 }}" height="" width=""  alt="{{ media.alt | escape }}" class="product-media-img" />
      </div>
      {% endfor %}
    </div>

    <!-- PRODUCT INFO -->
    <div class="custom-product-information">
      <h1 class="product-title">{{ product.title }}</h1>

      <!-- PRICE -->
      <div class="product-price" data-price>
        {{ product.selected_or_first_available_variant.price | money }}
      </div>

      {% if product.options_with_values.size > 0 %}
      {% for option in product.options_with_values %}
      <div class="qv-option-block" data-option="{{ option.name }}">
        <label>{{ option.name }}</label>
        <div class="qv-option-values">
          {% for value in option.values %}
          <button type="button" class="qv-option-btn {% if forloop.first %}active{% endif %}"
            data-option-name="{{ option.name }}" data-option-value="{{ value }}">
            {{ value }}
          </button>
          {% endfor %}
        </div>
      </div>
      {% endfor %}
      {% endif %}


      <!-- ADD TO CART FORM -->
      <form method="post" action="/cart/add" id="product-form-{{ section.id }}" class="product-form"
        enctype="multipart/form-data">
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}"
          id="selected-variant-id">
        <button type="submit" class="button button--primary" id="add-to-cart-btn">
          Add to cart
        </button>
        <p class="cart-status-message" style="display:none;"></p>
      </form>

      {% if product.description != blank %}
      <div class="product-description rte">
        {{ product.description }}
      </div>
      {% endif %}
    </div>
  </div>

  <script>
    document.addEventListener("DOMContentLoaded", function () {
      const priceEl = document.querySelector("[data-price]");
      const variantIdInput = document.getElementById("selected-variant-id");
      const addToCartBtn = document.getElementById("add-to-cart-btn");
      const statusMsg = document.querySelector(".cart-status-message");
      const productForm = document.querySelector("#product-form-{{ section.id }}");
      const variants = {{ product.variants | json
    }};
    const productOptions = {{ product.options_with_values | json }};

    // --- Shopify money formatter ---
    function formatMoney(cents) {
      return "₹" + (cents / 100).toFixed(2); // Change to your currency symbol
    }

    // --- Get current selected option values (Color, Size, etc.) ---
    function getSelectedOptions() {
      const selected = {};
      const groups = document.querySelectorAll(".product-option-fieldset, .qv-option-block");

      groups.forEach((group) => {
        const input = group.querySelector("input[type='radio']:checked, .qv-option-btn.active");
        if (input) {
          const name = group.dataset.optionName || group.getAttribute("data-option");
          const value = input.value || input.getAttribute("data-option-value");
          selected[name] = value;
        }
      });

      return selected;
    }

    // --- Find matching variant ---
    function findMatchingVariant(selected) {
      return variants.find((variant) => {
        return productOptions.every((opt, i) => {
          const optName = opt.name;
          const optValue = selected[optName];
          const variantValue = variant[`option${i + 1}`];
          return optValue && variantValue && optValue.toLowerCase() === variantValue.toLowerCase();
        });
      });
    }

    // --- Update product images (by color) ---
    function updateImages(selectedColor) {
      const mediaItems = document.querySelectorAll(".product-media-item");
      mediaItems.forEach((item) => {
        const img = item.querySelector("img");
        if (!img) return;
        const alt = img.alt.trim().toLowerCase();
        const match = alt.includes(selectedColor.toLowerCase());
        item.classList.toggle("hidden-by-color", !match);
      });
    }

    // --- Update UI for selected variant ---
    function updateVariantUI(variant) {
      if (!variant) {
        priceEl.innerHTML = formatMoney({{ product.selected_or_first_available_variant.price }});
      addToCartBtn.disabled = true;
      addToCartBtn.textContent = "Unavailable";
      return;
    }

    variantIdInput.value = variant.id;
    priceEl.innerHTML = formatMoney(variant.price);
    addToCartBtn.disabled = !variant.available;
    addToCartBtn.textContent = variant.available ? "Add to cart" : "Sold out";
  }

    // --- AJAX Add to Cart ---
    async function ajaxAddToCart(variantId) {
      try {
        addToCartBtn.disabled = true;
        addToCartBtn.textContent = "Adding...";

        const res = await fetch("/cart/add.js", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ id: variantId, quantity: 1 }),
        });

        if (!res.ok) throw new Error("Add to cart failed");
        const data = await res.json();

        statusMsg.textContent = `${data.title} added to cart`;
        statusMsg.style.display = "block";
        statusMsg.style.color = "green";

        // Refresh cart bubble
        const cartRes = await fetch("/cart.js");
        const cartData = await cartRes.json();
        const bubble = document.querySelector(".cart-bubble__text-count");
        if (bubble) bubble.textContent = cartData.item_count;

        addToCartBtn.textContent = "Add to cart";
        addToCartBtn.disabled = false;
      } catch (err) {
        console.error(err);
        statusMsg.textContent = "Error adding to cart";
        statusMsg.style.display = "block";
        statusMsg.style.color = "red";
        addToCartBtn.textContent = "Add to cart";
        addToCartBtn.disabled = false;
      }
    }

    // --- Handle option change (for both radio + button) ---
    document.addEventListener("click", function (e) {
      if (e.target.matches(".qv-option-btn")) {
        const group = e.target.closest(".qv-option-block");
        group.querySelectorAll(".qv-option-btn").forEach((btn) => btn.classList.remove("active"));
        e.target.classList.add("active");

        const selected = getSelectedOptions();
        const variant = findMatchingVariant(selected);

        if (selected.Color) updateImages(selected.Color);
        updateVariantUI(variant);
      }
    });

    document.addEventListener("change", function (e) {
      if (e.target.matches(".product-option-fieldset input[type='radio']")) {
        const selected = getSelectedOptions();
        const variant = findMatchingVariant(selected);

        if (selected.Color) updateImages(selected.Color);
        updateVariantUI(variant);
      }
    });

    // --- Handle Add to Cart ---
    productForm.addEventListener("submit", function (e) {
      e.preventDefault();
      const variantId = variantIdInput.value;
      ajaxAddToCart(variantId);
    });

    // --- Initial setup ---
    const selected = getSelectedOptions();
    const initialVariant = findMatchingVariant(selected);
    if (selected.Color) updateImages(selected.Color);
    updateVariantUI(initialVariant);
});
  </script>
</section>